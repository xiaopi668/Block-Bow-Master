function solveAim(origin, target, power){
  var v = 24 + power * 40;
  var g = 11;
  var dx = target.x - origin.x, dz = target.z - origin.z;【4/40】
  var d = Math.sqrt(dx*dx + dz*dz);
  var dy = target.y - origin.y;
  var under = v*v*v*v - g*(g*d*d + 2*dy*v*v);
  if(under < 0) return null;
  var th = Math.atan((v*v - Math.sqrt(under))【5/40】/ (g*d));
