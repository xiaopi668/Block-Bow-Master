    '#copyright-notice button:hover{filter:brightness(1.2)}',
    '#copyright-notice #notice-today{background:linear-gradient(#5a9b4a,#35702c)}',
    '@media(max-width:480px){#copyright-notice{padding:8px}#copyright-notice .notice-panel{max-height:94vh}#copyright-notice h2{font-size:19px}#copyright-notice .notice-body{padding:2px 14px 10px;font-size:12px;line-height:1.7}#copyright-notice .notice-actions{padding:10px;flex-direction:column}#copyright-notice button{width:100%}}'
