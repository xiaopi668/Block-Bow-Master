    '<div class=\"notice-warning\">发现抄袭或搬运，著作权人保留平台投诉、发函、公证存证、民事诉讼及依法索赔等权利。</div>\n' +
    '联系人：有梗的123　QQ：3885857418</div>' +
    '<div class=\"notice-actions\"><button id=\"notice-close\">关闭</button><button id=\"notice-today\">今日关闭</button></div>' +
    '</div>';

  function closeNotice() {
    notice.remove();
    style.remove();
  }

  function closeToday() {
    try {
      localStorage.setItem(STORAGE_KEY, today);
    } catch (e) {}
    closeNotice();
  }

  function mount() {
    if (!document.body) {
      return setTimeout(mount, 0);
    }
    document.body.appendChild(notice);
    document.getElementById('notice-close').addEventListener('click', closeNotice);
    document.getElementById('notice-today').addEventListener('click', closeToday);
  }

  mount();
