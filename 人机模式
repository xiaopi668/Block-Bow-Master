  /* 弹道: 求俯仰/偏航; 返回含飞行时间 */
  function solveAim(target, power) {
    var v = V_MIN + power * V_K;
    var dx = target.x - BOT_POS.x, dz = target.z - BOT_POS.z;
    var d = Math.hypot(dx, dz), dy = target.y - BOT_POS.y;
    var under = v * v * v * v - GRAVITY * (GRAVITY * d * d + 2 * dy * v * v);

    if (under < 0) return null;

    var th = Math.atan((v * v - Math.sqrt(under)) / (GRAVITY * d));
    return {
      yaw: Math.atan2(-dx, -dz),
      pitch: th,
      flight: d / (v * Math.cos(th))
    };
  }

  function clamp(v, a, b) {
    return Math.max(a, Math.min(b, v));
  }

  function botShoot() {
